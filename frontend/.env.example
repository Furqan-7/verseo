# Supabase → Project settings → API. The anon (publishable) key is safe in
# the browser; never put the service-role key in the frontend.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where the CreatorOS API (backend/) runs.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional: this site's public origin, used for Supabase email links and the
# Google sign-in return URL when the app sits behind a proxy.
# APP_URL=https://creatoros.example.com
