{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "start": "node dist/index.js",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "cors": "^2.8.6",
    "db": "workspace:*",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "unpdf": "^2.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
