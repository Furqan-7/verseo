# ── Required ────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# The frontend's origin(s), comma-separated. Requests from anywhere else are refused.
CORS_ORIGIN=http://localhost:3000

# Neon pooled connection string (same value as db/.env DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/creatoros?sslmode=require"

# Supabase → Project settings → API keys. The anon (publishable) key verifies sign-ins.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# ── Public addresses ────────────────────────────────────────────────────────

# The frontend's public origin (email links and the end of "Connect Google").
APP_URL=http://localhost:3000
# This API's public origin. Google sends people back to $API_URL/integrations/google/callback.
API_URL=http://localhost:4000

# ── Optional: each feature switches on when its keys are set ────────────────

# Uploads (videos, cut clips) and account deletion. Supabase → Project
# settings → API keys → service_role (secret). Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# A private Storage bucket; created on first upload if it doesn't exist.
STORAGE_BUCKET=uploads

# AI: Gemini (https://aistudio.google.com/apikey), with Groq as a fallback
# (https://console.groq.com/keys). Embeddings for search need Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gmail, Google Calendar and YouTube: a Google Cloud OAuth client
# (Web application) with $API_URL/integrations/google/callback as an
# authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts stored Google tokens. Generate with: openssl rand -base64 32
# Changing it later means everyone has to reconnect Google.
TOKEN_ENCRYPTION_KEY=

# The morning briefing email, through Resend (https://resend.com).
# EMAIL_FROM must be on a domain you verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="CreatorOS <briefing@yourdomain.com>"

# Run the background worker (syncs, alerts, briefings, publishing, embeddings)
# inside this process. Set to false if you run `pnpm --filter backend start:worker` separately.
RUN_WORKER=true
