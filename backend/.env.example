NODE_ENV=development
PORT=4000
# The frontend's origin(s), comma-separated. Requests from anywhere else are refused.
CORS_ORIGIN=http://localhost:3000

# Neon pooled connection string (same value as db/.env DATABASE_URL).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/creatoros?sslmode=require"

# Supabase → Project settings → API. Only the public anon (publishable) key:
# the API verifies tokens and never needs the service-role key.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
