// CreatorOS data model. Every table hangs off Profile, whose id is the
// Supabase Auth user id: sign-in, passwords and sessions stay in Supabase,
// and only the workspace data the app shows lives here.

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ── Profile, settings and connected accounts ────────────────────────────────

model Profile {
  id               String            @id @db.Uuid
  email            String
  name             String            @default("")
  channel          String            @default("")
  niche            String            @default("")
  goals            String[]
  // Settings › Briefing
  briefingTime     String            @default("8:00")
  briefingEmail    Boolean           @default(true)
  briefingSections BriefingSection[] @default([todo, inbox, ideas, deals])
  // Settings › Replies
  tone             Tone              @default(friendly)
  signOff          String            @default("")
  autoDraft        Category[]        @default([brand_deal, collab, fan_question])
  // Settings › Notifications: the alert kinds that are switched on
  notifications    AlertKind[]       @default([overdue, new_deal, deadline])
  onboardedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  accounts     ConnectedAccount[]
  messages     Message[]
  deals        Deal[]
  todos        Todo[]
  ideas        Idea[]
  events       CalendarEvent[]
  videos       Video[]
  alerts       Alert[]
  channelDays  ChannelDay[]
  contentPosts ContentPost[]
}

model ConnectedAccount {
  id        String        @id @default(cuid())
  profileId String        @db.Uuid
  provider  Provider
  status    AccountStatus
  updatedAt DateTime      @updatedAt
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, provider])
}

// ── Inbox ───────────────────────────────────────────────────────────────────

model Message {
  id             String        @id @default(cuid())
  profileId      String        @db.Uuid
  dealId         String?
  source         MessageSource
  category       Category
  fromName       String
  fromAddress    String
  avatarInitial  String
  avatarColor    String
  subject        String
  preview        String
  // Paragraphs; **bold** marks the key facts.
  body           String[]
  senderSignOff  String
  summary        String?
  receivedAt     DateTime
  // A reply CreatorOS drafted without being asked.
  draftReady     Boolean       @default(false)
  // The creator asked for a draft on a message that had none ready.
  draftRequested Boolean       @default(false)
  minutesSaved   Int           @default(0)
  tone           Tone?
  editedReply    String?
  readAt         DateTime?
  archivedAt     DateTime?
  approvedAt     DateTime?
  approvedReply  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profile Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deal    Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  drafts  MessageDraft[]

  @@index([profileId, archivedAt, receivedAt])
  @@index([dealId])
}

// One drafted reply per tone; ==marks== highlight the key points.
model MessageDraft {
  id        String  @id @default(cuid())
  messageId String
  tone      Tone
  text      String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, tone])
}

// ── Deals ───────────────────────────────────────────────────────────────────

model Deal {
  id              String     @id @default(cuid())
  profileId       String     @db.Uuid
  slug            String
  brand           String
  color           String
  campaign        String
  stage           DealStage
  amount          Int
  dueDate         DateTime   @db.Date
  source          String
  alertText       String?
  alertTone       AlertTone?
  healthFinancial Int
  healthDeadline  Int
  healthContract  Int
  healthScope     Int
  invoiceNumber   String?
  // The invoice's due date; an Invoiced deal past it is overdue.
  invoiceDueDate  DateTime?  @db.Date
  paidAt          DateTime?  @db.Date
  reminderDraft   String?
  inCalendar      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  terms        DealTerm[]
  risks        DealRisk[]
  deliverables Deliverable[]
  messages     Message[]
  alerts       Alert[]

  @@unique([profileId, slug])
  @@index([profileId, stage])
}

model DealTerm {
  id       String  @id @default(cuid())
  dealId   String
  position Int
  label    String
  value    String
  clause   String?
  missing  Boolean @default(false)
  deal     Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, position])
}

model DealRisk {
  id       String @id @default(cuid())
  dealId   String
  position Int
  title    String
  fix      String
  deal     Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, position])
}

model Deliverable {
  id       String   @id @default(cuid())
  dealId   String
  position Int
  title    String
  dueDate  DateTime @db.Date
  done     Boolean  @default(false)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, position])
}

// ── Today: to-dos and ideas ─────────────────────────────────────────────────

model Todo {
  id         String   @id @default(cuid())
  profileId  String   @db.Uuid
  ideaId     String?  @unique
  title      String
  detail     String   @default("")
  dueDate    DateTime @db.Date
  // Minutes from midnight; without them the to-do is for the whole day.
  dueMinutes Int?
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  idea    Idea?   @relation(fields: [ideaId], references: [id], onDelete: SetNull)

  @@index([profileId, dueDate])
}

model Idea {
  id        String         @id @default(cuid())
  profileId String         @db.Uuid
  title     String
  why       String
  platforms IdeaPlatform[]
  createdAt DateTime       @default(now())

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  todo    Todo?

  @@index([profileId])
}

// ── Calendar ────────────────────────────────────────────────────────────────
// Deal deadlines and scheduled posts are not copied here: the calendar
// reads them from Deal (inCalendar) and ScheduledPost.

model CalendarEvent {
  id           String    @id @default(cuid())
  profileId    String    @db.Uuid
  title        String
  type         EventType
  date         DateTime  @db.Date
  startMinutes Int?
  endMinutes   Int?
  detail       String?
  linkHref     String?
  linkLabel    String?
  tentative    Boolean   @default(false)
  done         Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, date])
}

// ── Publish ─────────────────────────────────────────────────────────────────

model Video {
  id        String   @id @default(cuid())
  profileId String   @db.Uuid
  fileName  String
  lengthSec Int
  quality   String
  createdAt DateTime @default(now())

  profile    Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  transcript TranscriptLine[]
  clips      Clip[]

  @@index([profileId, createdAt])
}

model TranscriptLine {
  id      String @id @default(cuid())
  videoId String
  sec     Int
  text    String
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, sec])
}

model Clip {
  id                String          @id @default(cuid())
  videoId           String
  position          Int
  short             String
  title             String
  quote             String
  // Current (possibly trimmed) range in seconds, and the range CreatorOS
  // suggested, so a trim can be undone.
  startSec          Int
  endSec            Int
  suggestedStartSec Int
  suggestedEndSec   Int
  why               String
  hook              Int
  color             String
  skipped           Boolean         @default(false)
  hashtags          String[]
  video             Video           @relation(fields: [videoId], references: [id], onDelete: Cascade)
  captions          ClipCaption[]
  posts             ScheduledPost[]

  @@unique([videoId, position])
}

// The caption options written for one platform, which one is picked, and
// the creator's own edit (which wins when set).
model ClipCaption {
  id       String          @id @default(cuid())
  clipId   String
  platform PublishPlatform
  options  String[]
  variant  Int             @default(0)
  text     String?
  clip     Clip            @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, platform])
}

model ScheduledPost {
  id          String          @id @default(cuid())
  clipId      String
  platform    PublishPlatform
  scheduledAt DateTime
  why         String
  caption     String
  createdAt   DateTime        @default(now())
  clip        Clip            @relation(fields: [clipId], references: [id], onDelete: Cascade)

  @@unique([clipId, platform])
  @@index([scheduledAt])
}

// ── Notifications ───────────────────────────────────────────────────────────

model Alert {
  id        String    @id @default(cuid())
  profileId String    @db.Uuid
  dealId    String?
  kind      AlertKind
  title     String
  detail    String
  href      String
  createdAt DateTime
  readAt    DateTime?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  deal    Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
}

// ── Analytics ───────────────────────────────────────────────────────────────

model ChannelDay {
  id           String   @id @default(cuid())
  profileId    String   @db.Uuid
  channel      Channel
  date         DateTime @db.Date
  views        Int
  followers    Int
  // YouTube only.
  watchMinutes Int?

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, channel, date])
}

model ContentPost {
  id         String   @id @default(cuid())
  profileId  String   @db.Uuid
  title      String
  channel    Channel
  format     String
  views      Int
  // Percent of viewers who liked, commented or shared.
  engagement Float
  postedAt   DateTime @db.Date

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, views])
}

// ── Enums ───────────────────────────────────────────────────────────────────

enum Provider {
  gmail
  calendar
  youtube
  instagram
  tiktok
}

enum AccountStatus {
  connected
  disconnected
  imported
  soon
}

enum BriefingSection {
  todo
  inbox
  ideas
  deals
}

enum Tone {
  friendly
  professional
  shorter
}

enum Category {
  brand_deal
  collab
  fan_question
  spam
}

enum MessageSource {
  gmail
  youtube
  instagram
}

enum DealStage {
  new_offer
  negotiating
  in_production
  invoiced
  paid
}

enum AlertTone {
  warn
  bad
}

enum IdeaPlatform {
  instagram
  youtube
  tiktok
  shorts
  reels
}

enum EventType {
  deadline
  post
  film
  call
}

enum PublishPlatform {
  reel
  short
  tiktok
}

enum AlertKind {
  overdue
  new_deal
  deadline
  weekly
}

enum Channel {
  youtube
  instagram
  tiktok
}
