# Neon PostgreSQL (https://console.neon.tech → your project → Connect).
# Pooled connection string, used by the app at runtime (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/creatoros?sslmode=require"
# Direct (unpooled) connection string, used by Prisma Migrate.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/creatoros?sslmode=require"
